{
  "$schema": "vscode://schemas/icon-theme",
  "usesCurrentColor": true,
  "iconDefinitions": {
    "_file": { "iconPath": "../icons/file-text.svg" },
    "_folder": { "iconPath": "../icons/folder.svg" },
    "_folder_expanded": { "iconPath": "../icons/folder-open-solid.svg" },
    "_script": { "iconPath": "../icons/script.svg" },
    "_json": { "iconPath": "../icons/json.svg" },
    "_python": { "iconPath": "../icons/python-solid.svg" },
    "_cpp": { "iconPath": "../icons/cpp.svg" },
    "_css": { "iconPath": "../icons/css-solid.svg" },
    "_md": { "iconPath": "../icons/markdown-solid.svg" },
    "_img": { "iconPath": "../icons/image.svg" },
    "_react": { "iconPath": "../icons/react.svg" },
    "_abc": { "iconPath": "../icons/abc.svg" },
    "_ai": { "iconPath": "../icons/adobe-illustrator.svg" },
    "_psd": { "iconPath": "../icons/adobe-photoshop.svg" },
    "_indd": { "iconPath": "../icons/adobe-indesign.svg" },
    "_docx": { "iconPath": "../icons/microsoft-word.svg" },
    "_pptx": { "iconPath": "../icons/microsoft-powerpoint.svg" },
    "_xlsx": { "iconPath": "../icons/microsoft-excel.svg" },
  },
  "file": "_file",
  "folder": "_folder",
  "folderExpanded": "_folder_expanded",
  "fileExtensions": {
    "ts": "_script",
    "js": "_script",
    "cjs": "_script",
    "mjs": "_script",
    "json": "_json",
    "py": "_python",
    "cpp": "_cpp",
    "css": "_css",
    "md": "_md",
    "mdx": "_md",
    "svg": "_img",
    "png": "_img",
    "jpg": "_img",
    "jpeg": "_img",
    "jpegxl": "_img",
    "webp": "_img",
    "tsx": "_react",
    "otf": "_abc",
    "ttf": "_abc",
    "ttc": "_abc",
    "woff": "_abc",
    "woff2": "_abc",
    "eot": "_abc",
    "pfa": "_abc",
    "pfb": "_abc",
    "afm": "_abc",
    "amfm": "_abc",
    "acfm": "_abc",
    "dfont": "_abc",
    "ai": "_ai",
    "psd": "_psd",
    "indd": "_indd"
  },
}