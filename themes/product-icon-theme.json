{
  "$schema": "vscode://schemas/product-icon-theme",
  "fonts": [
    {
      "id": "pixel-icons",
      "src": [
        {
          "path": "./pixel-icons.woff",
          "format": "woff"
        }
      ],
      "weight": "normal",
      "style": "normal"
    }
  ],
  "iconDefinitions": {
    "explorer-view-icon": {
      "fontCharacter": "\\e000",
    },
    "search-view-icon": {
      "fontCharacter": "\\e001"
    },
    "run-view-icon": {
      "fontCharacter": "\\e002"
    },
    "extensions-view-icon": {
      "fontCharacter": "\\e004"
    },
    "source-control-view-icon": {
      "fontCharacter": "\\e003"
    }
  }
}